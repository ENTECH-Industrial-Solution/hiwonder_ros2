<?xml version="1.0"?>
<sdf version="1.9">
  <!-- The mini game's pick pedestal. Placed so its front edge is 0.195 m from the docked robot's
       base (outside the 0.15 m turning circle; the demo's pedestal starts 1 cm from the skid, fine
       for a robot that never moves) and 0.16 m deep, extending BEHIND the cubes: an 0.08 m version
       lost a cube off the back edge whenever the gripper nudged its neighbour. Mid-grey rather than
       pick_pedestal's beige: pastel yellow on beige was the one cube neither detector could find. -->
  <model name="arena_pedestal">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.16 0.22 0.08</size></box></geometry>
        <material>
          <ambient>0.42 0.42 0.45 1</ambient>
          <diffuse>0.42 0.42 0.45 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.16 0.22 0.08</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
