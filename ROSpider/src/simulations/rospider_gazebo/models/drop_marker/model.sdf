<?xml version="1.0"?>
<sdf version="1.9">
  <model name="drop_marker">
    <static>true</static>
    <!-- Fix round 2: the three cubes now land in a side-by-side row (see
         config/pick_place.yaml's drop_slots) at y = +-0.07 and 0.0, spawned
         at (0.160, y, 0.082) with this model's own origin unchanged, so the
         marker is widened from 0.05x0.05 to 0.05x0.21 (+-0.105 in y) to
         visually cover the row it now marks. It still sits inside the
         pedestal footprint (x 0.13-0.27, |y| <= 0.11) and stays clear of the
         cube spawn column at x 0.21-0.26 (marker spans x 0.135-0.185). -->
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.05 0.21 0.004</size></box></geometry>
        <material>
          <ambient>0.95 0.85 0.1 1</ambient>
          <diffuse>0.95 0.85 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
