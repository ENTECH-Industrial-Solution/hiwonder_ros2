<?xml version="1.0"?>
<!-- Mini-game arena: a 6.0 m x 2.0 m hall with an S-bend. The robot spawns at the origin
     facing +x; mini_game.launch.py spawns the pick pedestal, the cubes and the tag stations,
     so this file stays a bare hall that SLAM and V-SLAM can map.

     Course, west to east:
       x 0.7..1.3   slanted panel on the north side - the first turn
       x 1.6        partition A from the north wall, 0.8 m gap on the south (y < -0.2)
       x 2.4        crate in the south-east corner of the chamber between the partitions
       x 2.6        partition B from the south wall, 0.8 m gap on the north (y > 0.2)
       (3.0, 0.3)   survey point: every station's tag and colour marker is in line of sight
       x 3.5        box on the south side
       x 4.2        two pillars, 1.1 m gap on the centre line (out of the survey's lines of sight)
       x 5.1        three stations along the east wall, facing the hall
     Everything is box/cylinder geometry (no meshes), 1 m walls with the same poster textures
     as rospider_room so V-SLAM has features. -->
<sdf version="1.9">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>2.4 1.025 0.5 0 0 0</pose><geometry><box><size>6.1 0.05 1.0</size></box></geometry></collision>
        <visual name="north_v"><pose>2.4 1.025 0.5 0 0 0</pose><geometry><box><size>6.1 0.05 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_north.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="south_c"><pose>2.4 -1.025 0.5 0 0 0</pose><geometry><box><size>6.1 0.05 1.0</size></box></geometry></collision>
        <visual name="south_v"><pose>2.4 -1.025 0.5 0 0 0</pose><geometry><box><size>6.1 0.05 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_south.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="west_c"><pose>-0.625 0 0.5 0 0 0</pose><geometry><box><size>0.05 2.1 1.0</size></box></geometry></collision>
        <visual name="west_v"><pose>-0.625 0 0.5 0 0 0</pose><geometry><box><size>0.05 2.1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_west.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="east_c"><pose>5.425 0 0.5 0 0 0</pose><geometry><box><size>0.05 2.1 1.0</size></box></geometry></collision>
        <visual name="east_v"><pose>5.425 0 0.5 0 0 0</pose><geometry><box><size>0.05 2.1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_east.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="partition_a_c"><pose>1.6 0.4 0.5 0 0 0</pose><geometry><box><size>0.05 1.2 1.0</size></box></geometry></collision>
        <visual name="partition_a_v"><pose>1.6 0.4 0.5 0 0 0</pose><geometry><box><size>0.05 1.2 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/partition.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="partition_b_c"><pose>2.6 -0.4 0.5 0 0 0</pose><geometry><box><size>0.05 1.2 1.0</size></box></geometry></collision>
        <visual name="partition_b_v"><pose>2.6 -0.4 0.5 0 0 0</pose><geometry><box><size>0.05 1.2 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_west.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="slant_panel">
      <static>true</static>
      <pose>1.0 0.55 0.5 0 0 -0.9</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.05 0.7 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.05 0.7 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/partition.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="box_obstacle">
      <static>true</static>
      <pose>3.5 -0.45 0.15 0 0 0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.3</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/box.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="crate_obstacle">
      <static>true</static>
      <pose>2.4 -0.85 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.5 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 0.3</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/crate.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="pillar_north">
      <static>true</static>
      <pose>4.2 0.65 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/cylinder.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="pillar_south">
      <static>true</static>
      <pose>4.2 -0.65 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.3</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/crate.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>
  </world>
</sdf>
