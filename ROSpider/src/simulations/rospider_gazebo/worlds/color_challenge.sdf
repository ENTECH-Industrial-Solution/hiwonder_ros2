<?xml version="1.0"?>
<!-- The Color Threshold exercise's scene (docs/superpowers/specs/2026-09-29-color-threshold-challenge-design.md).
     No walls: the room's posters carry patches of every colour. The robot spawns at the origin facing +x
     with the arm at init, so the camera looks at the floor 0.25-0.5 m ahead; rospider_gazebo/color_check.py's
     TARGETS are pixel boxes in that view, so moving a cube here means re-measuring them.
     Visual-only 6 cm cubes: red, green and a lit blue target; a second blue target in the shadow of the tall
     grey block (the sun comes from +x); an orange decoy that a too-wide red band catches. -->
<sdf version="1.9">
  <world name="color_challenge">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="red_target">
      <static>true</static>
      <pose>0.35 0.12 0.03 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material></visual></link>
    </model>
    <model name="orange_decoy">
      <static>true</static>
      <pose>0.35 -0.12 0.03 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material></visual></link>
    </model>
    <model name="green_target">
      <static>true</static>
      <pose>0.45 0.06 0.03 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><ambient>0.05 0.7 0.1 1</ambient><diffuse>0.05 0.7 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="shade_block">
      <static>true</static>
      <pose>0.53 -0.075 0.2 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.04 0.09 0.4</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual></link>
    </model>
    <model name="blue_target">
      <static>true</static>
      <pose>0.45 -0.06 0.03 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual></link>
    </model>
    <model name="blue_shade">
      <static>true</static>
      <pose>0.28 0.0 0.03 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
        <material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
