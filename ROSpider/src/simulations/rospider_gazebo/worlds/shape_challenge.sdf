<?xml version="1.0"?>
<!-- The 3D Shape Recognition exercise's scene (docs/superpowers/specs/2026-09-29-shape-recognition-challenge-design.md).
     No walls. The robot spawns at the origin facing +x; object_classification's look pose points the camera down
     at the floor about 0.28 m below (0.27-0.29 m across the frame: the camera is tipped a little). Three visual-only
     3 cm solids: a cylinder straight under the camera and a cuboid beside it (the bottom-middle of the picture), and
     the sphere the exercise asks for at the top edge, outside a region of interest that starts too low.
     rospider_gazebo/shape_check.py's EXPECTED are pixel boxes in that view, so moving a solid means re-measuring them.
     Only 3 cm tall on purpose: the floor then lies within 40 mm of the nearest top, so a floor distance set too far
     (upstream's 350 mm) turns the whole floor into one object. -->
<sdf version="1.9">
  <world name="shape_challenge">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cuboid">
      <static>true</static>
      <pose>0.21 0.07 0.015 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><box><size>0.03 0.03 0.03</size></box></geometry>
        <material><ambient>0.05 0.7 0.1 1</ambient><diffuse>0.05 0.7 0.1 1</diffuse></material></visual></link>
    </model>
    <model name="sphere">
      <static>true</static>
      <pose>0.315 -0.02 0.015 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material></visual></link>
    </model>
    <model name="cylinder">
      <static>true</static>
      <pose>0.21 0.0 0.015 0 0 0</pose>
      <link name="link"><visual name="v"><geometry><cylinder><radius>0.015</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
