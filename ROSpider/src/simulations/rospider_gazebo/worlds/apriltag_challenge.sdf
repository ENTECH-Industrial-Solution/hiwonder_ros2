<?xml version="1.0"?>
<!-- The AprilTag Tracking exercise's scene (docs/superpowers/specs/2026-09-29-apriltag-challenge-design.md).
     Generated by tools/make_apriltag_world.py from rospider_gazebo/tag_check.py's STATIONS; edit those.
     Three tag stations face the spawn point; the robot must walk to tag 2. No walls, no posters. -->
<sdf version="1.9">
  <world name="apriltag_challenge">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="tag_station_0">
    <pose>1.0 0.45 0 0 0 3.14159</pose>
    <static>true</static>
    <link name="link">
      <collision name="pedestal_c">
        <pose>0 0 0.040000 0 0 0</pose>
        <geometry><box><size>0.140000 0.220000 0.080000</size></box></geometry>
      </collision>
      <visual name="pedestal_v">
        <pose>0 0 0.040000 0 0 0</pose>
        <geometry><box><size>0.140000 0.220000 0.080000</size></box></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1</ambient>
          <diffuse>0.6 0.6 0.62 1</diffuse>
        </material>
      </visual>
      <collision name="post_c">
        <pose>-0.120000 0 0.072500 0 0 0</pose>
        <geometry><box><size>0.030000 0.030000 0.145000</size></box></geometry>
      </collision>
      <visual name="post_v">
        <pose>-0.120000 0 0.072500 0 0 0</pose>
        <geometry><box><size>0.030000 0.030000 0.145000</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.32 1</ambient>
          <diffuse>0.3 0.3 0.32 1</diffuse>
        </material>
      </visual>
      <collision name="board_c">
        <pose>-0.120000 0 0.250000 0 0 0</pose>
        <geometry><box><size>0.010000 0.210000 0.210000</size></box></geometry>
      </collision>
      <visual name="board_v">
        <pose>-0.120000 0 0.250000 0 0 0</pose>
        <geometry><box><size>0.010000 0.210000 0.210000</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>textures/tag_0.png</albedo_map>
            <roughness>0.9</roughness>
            <metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
    <model name="tag_station_1">
    <pose>1.2 0.0 0 0 0 3.14159</pose>
    <static>true</static>
    <link name="link">
      <collision name="pedestal_c">
        <pose>0 0 0.040000 0 0 0</pose>
        <geometry><box><size>0.140000 0.220000 0.080000</size></box></geometry>
      </collision>
      <visual name="pedestal_v">
        <pose>0 0 0.040000 0 0 0</pose>
        <geometry><box><size>0.140000 0.220000 0.080000</size></box></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1</ambient>
          <diffuse>0.6 0.6 0.62 1</diffuse>
        </material>
      </visual>
      <collision name="post_c">
        <pose>-0.120000 0 0.072500 0 0 0</pose>
        <geometry><box><size>0.030000 0.030000 0.145000</size></box></geometry>
      </collision>
      <visual name="post_v">
        <pose>-0.120000 0 0.072500 0 0 0</pose>
        <geometry><box><size>0.030000 0.030000 0.145000</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.32 1</ambient>
          <diffuse>0.3 0.3 0.32 1</diffuse>
        </material>
      </visual>
      <collision name="board_c">
        <pose>-0.120000 0 0.250000 0 0 0</pose>
        <geometry><box><size>0.010000 0.210000 0.210000</size></box></geometry>
      </collision>
      <visual name="board_v">
        <pose>-0.120000 0 0.250000 0 0 0</pose>
        <geometry><box><size>0.010000 0.210000 0.210000</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>textures/tag_1.png</albedo_map>
            <roughness>0.9</roughness>
            <metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
    <model name="tag_station_2">
    <pose>1.0 -0.45 0 0 0 3.14159</pose>
    <static>true</static>
    <link name="link">
      <collision name="pedestal_c">
        <pose>0 0 0.040000 0 0 0</pose>
        <geometry><box><size>0.140000 0.220000 0.080000</size></box></geometry>
      </collision>
      <visual name="pedestal_v">
        <pose>0 0 0.040000 0 0 0</pose>
        <geometry><box><size>0.140000 0.220000 0.080000</size></box></geometry>
        <material>
          <ambient>0.6 0.6 0.62 1</ambient>
          <diffuse>0.6 0.6 0.62 1</diffuse>
        </material>
      </visual>
      <collision name="post_c">
        <pose>-0.120000 0 0.072500 0 0 0</pose>
        <geometry><box><size>0.030000 0.030000 0.145000</size></box></geometry>
      </collision>
      <visual name="post_v">
        <pose>-0.120000 0 0.072500 0 0 0</pose>
        <geometry><box><size>0.030000 0.030000 0.145000</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.32 1</ambient>
          <diffuse>0.3 0.3 0.32 1</diffuse>
        </material>
      </visual>
      <collision name="board_c">
        <pose>-0.120000 0 0.250000 0 0 0</pose>
        <geometry><box><size>0.010000 0.210000 0.210000</size></box></geometry>
      </collision>
      <visual name="board_v">
        <pose>-0.120000 0 0.250000 0 0 0</pose>
        <geometry><box><size>0.010000 0.210000 0.210000</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>textures/tag_2.png</albedo_map>
            <roughness>0.9</roughness>
            <metalness>0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
  </world>
</sdf>
