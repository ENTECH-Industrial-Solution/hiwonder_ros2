<?xml version="1.0"?>
<!-- 4 m x 3 m room for ROSpider. Walls are 0.4 m high; the LiDAR scan plane is ~0.15 m above the floor.
     The robot spawns at the origin facing +x; the three small cubes in front of it are visual-only colour-detection targets
     (no collision: they sit below the LiDAR plane, so Nav2 could not avoid them). -->
<sdf version="1.9">
  <world name="rospider_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>0 1.525 0.2 0 0 0</pose><geometry><box><size>4.1 0.05 0.4</size></box></geometry></collision>
        <visual name="north_v"><pose>0 1.525 0.2 0 0 0</pose><geometry><box><size>4.1 0.05 0.4</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
        <collision name="south_c"><pose>0 -1.525 0.2 0 0 0</pose><geometry><box><size>4.1 0.05 0.4</size></box></geometry></collision>
        <visual name="south_v"><pose>0 -1.525 0.2 0 0 0</pose><geometry><box><size>4.1 0.05 0.4</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
        <collision name="east_c"><pose>2.025 0 0.2 0 0 0</pose><geometry><box><size>0.05 3.0 0.4</size></box></geometry></collision>
        <visual name="east_v"><pose>2.025 0 0.2 0 0 0</pose><geometry><box><size>0.05 3.0 0.4</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
        <collision name="west_c"><pose>-2.025 0 0.2 0 0 0</pose><geometry><box><size>0.05 3.0 0.4</size></box></geometry></collision>
        <visual name="west_v"><pose>-2.025 0 0.2 0 0 0</pose><geometry><box><size>0.05 3.0 0.4</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
        <collision name="partition_c"><pose>-0.8 0.75 0.2 0 0 0</pose><geometry><box><size>0.05 1.5 0.4</size></box></geometry></collision>
        <visual name="partition_v"><pose>-0.8 0.75 0.2 0 0 0</pose><geometry><box><size>0.05 1.5 0.4</size></box></geometry><material><ambient>0.9 0.9 0.85 1</ambient><diffuse>0.9 0.9 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_obstacle">
      <static>true</static>
      <pose>1.2 0.8 0.15 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.3 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.3 0.3</size></box></geometry><material><ambient>0.55 0.4 0.25 1</ambient><diffuse>0.55 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>

    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>1.0 -0.8 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <model name="crate_obstacle">
      <static>true</static>
      <pose>-1.4 -0.9 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.5 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 0.5 0.3</size></box></geometry><material><ambient>0.25 0.45 0.3 1</ambient><diffuse>0.25 0.45 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <model name="red_cube">
      <static>true</static>
      <pose>0.55 0.12 0.025 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <model name="green_cube">
      <static>true</static>
      <pose>0.55 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.05 0.8 0.05 1</ambient><diffuse>0.05 0.8 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <model name="blue_cube">
      <static>true</static>
      <pose>0.55 -0.12 0.025 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.05 0.1 0.9 1</ambient><diffuse>0.05 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
