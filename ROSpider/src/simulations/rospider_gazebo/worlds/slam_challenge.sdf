<?xml version="1.0"?>
<!-- The SLAM Mapping exercise room (docs/superpowers/specs/2026-09-28-slam-challenge-design.md).
     Inside the walls: x -1.0..4.0, y -2.0..2.0. A partition centred on x = 1.0 splits it into room A
     (2 m wide; the robot spawns at the origin facing +x) and room B (3 m); the doorway is the gap
     y 0.3..0.8. rospider_gazebo/slam_check.py's DOOR_X / DOOR_Y depend on these numbers.
     The rooms are deliberately unlike each other (widths, off-centre doorway, the stub in B): two
     mirror-image rooms made slam_toolbox's loop closure match B onto A and shift the map a room width.
     Room B is a course (the user's sketch): maze walls from the doorway's left jamb (1.0, 0.9) to (2.0, 0.9),
     along x = 2.0 to y = -1.2, diagonally to (2.8, 0.0) and on to the stub at (2.8, 1.0). The robot goes
     through the doorway, right along the 1 m corridor, up past the cylinder (3.13, -1.13) r 0.2 on either
     side (gaps to the wall faces: left 0.68, right 0.67, top 0.67 m; r 0.25 left 0.58 m on the left,
     where RPP stopped with "collision ahead" until the goal aborted) and along the far wall to the top-left corner.
     Each inner wall's visual is two 0.025 m faces with their own poster (tools/make_face_textures.py): with
     one texture on every face, V-SLAM loop closure matched room A onto the corridor, 1.2 m off. Collisions
     are the single 0.05 m boxes, so the LiDAR map is unchanged. -->
<sdf version="1.9">
  <world name="slam_challenge">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_c"><pose>1.5 2.025 0.5 0 0 0</pose><geometry><box><size>5.1 0.05 1.0</size></box></geometry></collision>
        <visual name="north_v"><pose>1.5 2.025 0.5 0 0 0</pose><geometry><box><size>5.1 0.05 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_north.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="south_c"><pose>1.5 -2.025 0.5 0 0 0</pose><geometry><box><size>5.1 0.05 1.0</size></box></geometry></collision>
        <visual name="south_v"><pose>1.5 -2.025 0.5 0 0 0</pose><geometry><box><size>5.1 0.05 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_south.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="east_c"><pose>4.025 0 0.5 0 0 0</pose><geometry><box><size>0.05 4.1 1.0</size></box></geometry></collision>
        <visual name="east_v"><pose>4.025 0 0.5 0 0 0</pose><geometry><box><size>0.05 4.1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_east.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="west_c"><pose>-1.025 0 0.5 0 0 0</pose><geometry><box><size>0.05 4.1 1.0</size></box></geometry></collision>
        <visual name="west_v"><pose>-1.025 0 0.5 0 0 0</pose><geometry><box><size>0.05 4.1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_west.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="partition_n_c"><pose>1.0 1.4 0.5 0 0 0</pose><geometry><box><size>0.05 1.2 1.0</size></box></geometry></collision>
        <visual name="partition_n_a_v"><pose>1.0125 1.4000 0.5 0 0 0.0000</pose><geometry><box><size>0.025 1.2 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_partition_n_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="partition_n_b_v"><pose>0.9875 1.4000 0.5 0 0 0.0000</pose><geometry><box><size>0.025 1.2 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_partition_n_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="partition_s_c"><pose>1.0 -0.85 0.5 0 0 0</pose><geometry><box><size>0.05 2.3 1.0</size></box></geometry></collision>
        <visual name="partition_s_a_v"><pose>1.0125 -0.8500 0.5 0 0 0.0000</pose><geometry><box><size>0.025 2.3 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_partition_s_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="partition_s_b_v"><pose>0.9875 -0.8500 0.5 0 0 0.0000</pose><geometry><box><size>0.025 2.3 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_partition_s_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="stub_c"><pose>2.8 1.5 0.5 0 0 0</pose><geometry><box><size>0.05 1.0 1.0</size></box></geometry></collision>
        <visual name="stub_a_v"><pose>2.8125 1.5000 0.5 0 0 0.0000</pose><geometry><box><size>0.025 1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_stub_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="stub_b_v"><pose>2.7875 1.5000 0.5 0 0 0.0000</pose><geometry><box><size>0.025 1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_stub_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="maze_1_c"><pose>1.5000 0.9000 0.5 0 0 0.0000</pose><geometry><box><size>1.0500 0.05 1.0</size></box></geometry></collision>
        <visual name="maze_1_a_v"><pose>1.5000 0.9125 0.5 0 0 0.0000</pose><geometry><box><size>1.05 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_1_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="maze_1_b_v"><pose>1.5000 0.8875 0.5 0 0 0.0000</pose><geometry><box><size>1.05 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_1_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="maze_2_c"><pose>2.0000 -0.1500 0.5 0 0 -1.5708</pose><geometry><box><size>2.1500 0.05 1.0</size></box></geometry></collision>
        <visual name="maze_2_a_v"><pose>2.0125 -0.1500 0.5 0 0 -1.5708</pose><geometry><box><size>2.15 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_2_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="maze_2_b_v"><pose>1.9875 -0.1500 0.5 0 0 -1.5708</pose><geometry><box><size>2.15 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_2_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="maze_3_c"><pose>2.4000 -0.6000 0.5 0 0 0.9828</pose><geometry><box><size>1.4922 0.05 1.0</size></box></geometry></collision>
        <visual name="maze_3_a_v"><pose>2.3896 -0.5931 0.5 0 0 0.9828</pose><geometry><box><size>1.4922 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_3_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="maze_3_b_v"><pose>2.4104 -0.6069 0.5 0 0 0.9828</pose><geometry><box><size>1.4922 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_3_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <collision name="maze_4_c"><pose>2.8000 0.5000 0.5 0 0 1.5708</pose><geometry><box><size>1.0500 0.05 1.0</size></box></geometry></collision>
        <visual name="maze_4_a_v"><pose>2.7875 0.5000 0.5 0 0 1.5708</pose><geometry><box><size>1.05 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_4_a.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
        <visual name="maze_4_b_v"><pose>2.8125 0.5000 0.5 0 0 1.5708</pose><geometry><box><size>1.05 0.025 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/face_maze_4_b.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="box_obstacle">
      <static>true</static>
      <pose>-0.3 1.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.3</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/box.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>

    <model name="pillar">
      <static>true</static>
      <pose>3.13 -1.13 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/cylinder.png</albedo_map><roughness>0.9</roughness><metalness>0</metalness></metal></pbr></material></visual>
      </link>
    </model>
  </world>
</sdf>
